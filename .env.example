DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_STATIC_ROOT=
DATABASE_URL=sqlite:///foxpay.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=0
FOXPAY_ASYNC_TASKS_ENABLED=1

FOXPAY_ENV=test
FOXPAY_CARD_PROVIDER=mock
FOXPAY_CARD_PROVIDER_CHECKOUT_URL=
FOXPAY_CRYPTO_PROVIDER=manual
FOXPAY_WEBHOOK_SECRET=change-me-for-provider-webhooks
FOXPAY_API_RATE_LIMIT_PER_MINUTE=120
# Comma-separated trusted reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For.
FOXPAY_TRUSTED_PROXY_IPS=
FOXPAY_API_IP_RATE_LIMIT_PER_MINUTE=180
FOXPAY_INTENT_RATE_LIMIT_PER_MERCHANT=60
FOXPAY_INTENT_RATE_LIMIT_PER_IP=30
FOXPAY_PROVIDER_CALL_RATE_LIMIT_PER_MERCHANT=120
FOXPAY_PROVIDER_CALL_RATE_LIMIT_PER_IP=60
FOXPAY_ATTEMPT_AMOUNT_LIMIT_HOURLY=10000000
FOXPAY_ATTEMPT_AMOUNT_LIMIT_DAILY=50000000
FOXPAY_SMALL_PAYMENT_AMOUNT=200
FOXPAY_CARD_TEST_MIN_OUTCOMES=12
FOXPAY_CARD_TEST_FAILURE_RATIO=0.8
FOXPAY_CARD_TEST_SMALL_RATIO=0.7
FOXPAY_TEMP_RESTRICTION_SECONDS=1800
FOXPAY_ABUSE_FAIL_CLOSED=1
FOXPAY_WEBHOOK_MAX_ATTEMPTS=8
FOXPAY_WEBHOOK_MAX_BACKOFF_SECONDS=21600
FOXPAY_RECONCILE_AFTER_SECONDS=120
FOXPAY_SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-secret
FOXPAY_SELLER_SIGNUP_ENABLED=0
FOXPAY_PENDING_TEST_PAYMENTS_ENABLED=0
FOXPAY_STRIPE_CONNECT_ENABLED=0
FOXPAY_SQUARE_OAUTH_ENABLED=0
FOXPAY_NOWPAYMENTS_SELF_SERVICE_ENABLED=0
FOXPAY_PAYPAL_PARTNER_ENABLED=0

# TG11 Accounts OIDC client. Register foxpay with the exact callback URL.
TG11_OIDC_ISSUER=https://accounts.tg11.org
TG11_OIDC_CLIENT_ID=foxpay
TG11_OIDC_CLIENT_SECRET=
TG11_OIDC_REDIRECT_URI=https://foxpay.fyi/auth/tg11/callback/

# Optional Stripe bridge. Prefer storing production values as encrypted
# ProviderCredential rows with configure_stripe_provider. These variables are
# useful for local development, CI, or one-time command input.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
# Stripe Standard Connect OAuth uses FoxPay platform keys, never seller keys.
STRIPE_CONNECT_CLIENT_ID_TEST=
STRIPE_CONNECT_CLIENT_ID_LIVE=
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=
PAYPAL_PARTNER_CLIENT_ID_TEST=
PAYPAL_PARTNER_CLIENT_SECRET_TEST=
PAYPAL_PARTNER_MERCHANT_ID_TEST=
PAYPAL_PARTNER_ATTRIBUTION_ID_TEST=
PAYPAL_PARTNER_WEBHOOK_ID_TEST=
PAYPAL_PARTNER_CLIENT_ID_LIVE=
PAYPAL_PARTNER_CLIENT_SECRET_LIVE=
PAYPAL_PARTNER_MERCHANT_ID_LIVE=
PAYPAL_PARTNER_ATTRIBUTION_ID_LIVE=
PAYPAL_PARTNER_WEBHOOK_ID_LIVE=
SQUARE_APPLICATION_ID_TEST=
SQUARE_APPLICATION_SECRET_TEST=
SQUARE_APPLICATION_ID_LIVE=
SQUARE_APPLICATION_SECRET_LIVE=
SQUARE_OAUTH_WEBHOOK_SIGNATURE_KEY_TEST=
SQUARE_OAUTH_WEBHOOK_SIGNATURE_KEY_LIVE=
SQUARE_OAUTH_WEBHOOK_URL_TEST=https://foxpay.example/api/v1/webhooks/square/oauth/test/
SQUARE_OAUTH_WEBHOOK_URL_LIVE=https://foxpay.example/api/v1/webhooks/square/oauth/live/
# Configure connected-account events at /api/v1/webhooks/stripe/connect/test/
# and /api/v1/webhooks/stripe/connect/live/. Stripe production destinations
# can deliver test events too; FoxPay routes by the signed event's livemode.

# NOWPayments hosted crypto checkout. Run configure_nowpayments_provider to
# encrypt these values into per-merchant ProviderCredential rows. Leave the
# provider inactive until both values are available. The IPN URL for VulpFin is
# https://foxpay.fyi/api/v1/webhooks/nowpayments/vulpfin/nowpayments-primary/
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Square webhook and hosted checkout. Store production values as encrypted
# ProviderCredential rows with the configure_square_* commands.
# https://foxpay.fyi/api/v1/webhooks/square/vulpfin/square-primary/
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=

# Optional bootstrap provider routes. The bootstrap_merchant command imports
# this JSON into ProviderConfig rows so each merchant can expose multiple
# card/crypto options and keep backups ready if a provider is unavailable.
# Use adapter=mock only for local testing. Use adapter=stripe to route card and
# debit card payments through Stripe-hosted Checkout. Use adapter=hosted for
# another card provider that owns card entry on its PCI-compliant hosted checkout.
FOXPAY_PROVIDER_CONFIGS='[{"kind":"card","provider":"stripe-primary","adapter":"stripe","display_name":"Stripe Checkout","priority":10,"is_active":false,"settings":{"payment_method_types":["card"],"automatic_tax":true,"tax_behavior":"exclusive"}},{"kind":"card","provider":"card-sandbox","adapter":"mock","display_name":"Test card route","priority":20,"is_active":true,"settings":{}},{"kind":"card","provider":"card-backup","adapter":"hosted","display_name":"Backup card acquirer","priority":30,"is_active":false,"settings":{"checkout_url":"https://card-backup.example/checkout"}},{"kind":"crypto","provider":"btc-primary","adapter":"manual","display_name":"BTC primary wallet","priority":10,"is_active":true,"settings":{"addresses":{"BTC":"bc1qreplace-with-primary-wallet"}}},{"kind":"crypto","provider":"btc-backup","adapter":"manual","display_name":"BTC backup wallet","priority":20,"is_active":false,"settings":{"addresses":{"BTC":"bc1qreplace-with-backup-wallet"}}}]'

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=0
