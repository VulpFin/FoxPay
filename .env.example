DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_STATIC_ROOT=
DATABASE_URL=sqlite:///foxpay.sqlite3

FOXPAY_ENV=test
FOXPAY_CARD_PROVIDER=mock
FOXPAY_CARD_PROVIDER_CHECKOUT_URL=
FOXPAY_CRYPTO_PROVIDER=manual
FOXPAY_WEBHOOK_SECRET=change-me-for-provider-webhooks
FOXPAY_API_RATE_LIMIT_PER_MINUTE=120
FOXPAY_SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Optional Stripe bridge. Prefer storing production values as encrypted
# ProviderCredential rows with configure_stripe_provider. These variables are
# useful for local development, CI, or one-time command input.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NOWPayments hosted crypto checkout. Run configure_nowpayments_provider to
# encrypt these values into per-merchant ProviderCredential rows. Leave the
# provider inactive until both values are available. The IPN URL for VulpFin is
# https://foxpay.fyi/api/v1/webhooks/nowpayments/vulpfin/nowpayments-primary/
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional bootstrap provider routes. The bootstrap_merchant command imports
# this JSON into ProviderConfig rows so each merchant can expose multiple
# card/crypto options and keep backups ready if a provider is unavailable.
# Use adapter=mock only for local testing. Use adapter=stripe to route card and
# debit card payments through Stripe-hosted Checkout. Use adapter=hosted for
# another card provider that owns card entry on its PCI-compliant hosted checkout.
FOXPAY_PROVIDER_CONFIGS='[{"kind":"card","provider":"stripe-primary","adapter":"stripe","display_name":"Stripe Checkout","priority":10,"is_active":false,"settings":{"payment_method_types":["card"],"automatic_tax":true,"tax_behavior":"exclusive"}},{"kind":"card","provider":"card-sandbox","adapter":"mock","display_name":"Test card route","priority":20,"is_active":true,"settings":{}},{"kind":"card","provider":"card-backup","adapter":"hosted","display_name":"Backup card acquirer","priority":30,"is_active":false,"settings":{"checkout_url":"https://card-backup.example/checkout"}},{"kind":"crypto","provider":"btc-primary","adapter":"manual","display_name":"BTC primary wallet","priority":10,"is_active":true,"settings":{"addresses":{"BTC":"bc1qreplace-with-primary-wallet"}}},{"kind":"crypto","provider":"btc-backup","adapter":"manual","display_name":"BTC backup wallet","priority":20,"is_active":false,"settings":{"addresses":{"BTC":"bc1qreplace-with-backup-wallet"}}}]'

SENTRY_DSN=https://f1558d3a7234288b3fc82fa1fcc2dbc8@o4511250973196288.ingest.us.sentry.io/4511311303933952
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=0
